# ============================================
# CMS MONSA - Environment Variables
# ============================================
# Copy file ini ke .env dan isi nilainya.
# Untuk produksi: salin sebagai .env.production di server.

# Debug flag (hanya untuk penanda; Next.js produksi tidak pernah
# membocorkan stack trace). JANGAN set true di produksi.
APP_DEBUG="false"

# Database (PostgreSQL untuk produksi)
# SQLite (dev): DATABASE_URL="file:../db/custom.db"
DATABASE_URL="postgresql://postgres:password@localhost:5432/cms_mongisidi?schema=public"

# Redis (opsional) — dipakai untuk rate limiting terdistribusi (multi-instance).
# Tanpa REDIS_URL, rate limiter otomatis memakai fallback in-memory
# (cocok utk single-instance self-hosted).
# Contoh: REDIS_URL="redis://localhost:6379"
REDIS_URL=""

# Authentication
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WAJIB diisi untuk production!
AUTH_SECRET="your-random-secret-here"

# Site URL (untuk SEO, email, dan sitemap)
NEXT_PUBLIC_SITE_URL="https://sdn-mongisidi1.sch.id"

# CORS: origin yang diizinkan memanggil /api/* (dipisah koma).
# Kosongkan jika tidak ada frontend/domain terpisah.
# Contoh: ALLOWED_ORIGINS="https://admin.sdn-mongisidi1.sch.id"
ALLOWED_ORIGINS=""

# ============================================
# Email Configuration (opsional)
# ============================================
# Digunakan untuk notifikasi form kontak dan pengaduan
# Untuk Gmail: gunakan App Password, bukan password biasa
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="CMS MONSA <noreply@sdn-mongisidi1.sch.id>"

# Email admin untuk menerima notifikasi
ADMIN_EMAIL="admin@sdn-mongisidi1.sch.id"

# ============================================
# Sentry Error Tracking (opsional)
# ============================================
# DSN dari Sentry project — kosongkan jika tidak pakai Sentry.
# Client-side (browser): NEXT_PUBLIC_SENTRY_DSN
# Server-side: SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Auth token untuk source map upload (hanya butuh saat build)
SENTRY_AUTH_TOKEN=""

# ============================================
# Log Aggregation — Loki (opsional)
# ============================================
# URL Loki untuk mengirim logs. Kosongkan untuk stdout only.
# Jalankan stack logging: docker compose -f docker-compose.logging.yml up -d
# Contoh: LOKI_URL="http://localhost:3100/loki/api/v1/push"
LOKI_URL=""

# ============================================
# SSL / Domain Configuration
# ============================================
# Domain untuk SSL certificate (Let's Encrypt)
SITE_DOMAIN="sdn-mongisidi1.sch.id"

# App port (default 3000, change if needed)
APP_PORT="3000"
