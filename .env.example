# ============================================
# CMS MONSA - Environment Variables
# ============================================
# Copy file ini ke .env dan isi nilainya.
# Untuk produksi: salin sebagai .env.production di server.

# Debug flag (hanya untuk penanda; Next.js produksi tidak pernah
# membocorkan stack trace). JANGAN set true di produksi.
APP_DEBUG="false"

# Database — PostgreSQL untuk SEMUA environment (dev lokal = produksi).
# Skema tunggal: prisma/schema.prisma (dulu ada varian SQLite — dihapus).
#
# ── DEV LOKAL (pilih salah satu) ─────────────────────────────────
# A. Neon branch `dev` (TERMUDAH — tidak perlu apa pun di lokal):
#      1. Console Neon → project Anda → Branches → Create branch → "dev"
#      2. Salin connection string branch dev (DIRECT, tanpa -pooler)
#   DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/cms_mongisidi?sslmode=require"
#   lalu: bun run db:push && bun run db:seed
#
# B. PostgreSQL lokal via Docker (offline):
#   docker compose -f docker-compose.dev.yml up -d
#   DATABASE_URL="postgresql://mons:mons@localhost:5432/cms_mongisidi_dev?schema=public"
#   lalu: bun run db:push && bun run db:seed
#
# ── PRODUKSI (Vercel + Neon) ──────────────────────────────────────
# DUA koneksi untuk Neon (branch `main`):
#   DATABASE_URL        — koneksi POOLED untuk runtime (Vercel serverless).
#                         Hostname memakai "-pooler" dan query param
#                         `pgbouncer=true` (Prisma memberi tahu ini pooled).
#                         Dipakai aplikasi di semua query normal.
#   DATABASE_URL_DIRECT — koneksi DIRECT (non-pooler) untuk operasi skema:
#                         `prisma migrate deploy` / seed via
#                         scripts/deploy-vercel.sh. Bila TIDAK di-set,
#                         deploy script fallback ke DATABASE_URL.
# Contoh Neon — POOLED (runtime/Vercel):
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/cms_mongisidi?sslmode=require&pgbouncer=true"
# Contoh Neon — DIRECT (migrasi/seed):
#   DATABASE_URL_DIRECT="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/cms_mongisidi?sslmode=require"
DATABASE_URL="postgresql://mons:mons@localhost:5432/cms_mongisidi_dev?schema=public"
# DATABASE_URL_DIRECT=""

# Redis (opsional) — dipakai untuk rate limiting terdistribusi (multi-instance).
# Tanpa REDIS_URL, rate limiter otomatis memakai fallback in-memory
# (cocok utk single-instance self-hosted).
# Contoh: REDIS_URL="redis://localhost:6379"
REDIS_URL=""

# ============================================
# File Upload Storage
# ============================================
# Backend penyimpanan upload (gambar berita/galeri + PDF transparansi BOS):
#   - "disk" (default self-host): file di public/uploads — WAJIB persist di
#     volume (docker-compose.yml sudah mount uploads-data:/app/public/uploads).
#   - "db"    (default di Vercel, VERCEL=1): file di tabel UploadedFile
#     (bytea di Neon PostgreSQL) dan diserve lewat /uploads/[...path].
#     Dipakai otomatis di Vercel karena filesystem serverless ephemeral.
# Kosongkan untuk deteksi otomatis (Vercel → db, selain itu → disk).
UPLOAD_STORAGE=""

# Batas ukuran upload dalam MB (opsional — satu angka untuk semua jenis).
# Default tanpa env: 5 MB (gambar) / 15 MB (PDF) di self-host; 4 MB di Vercel
# karena Vercel membatasi request body Serverless Function di 4.5 MB pada
# level platform (tidak bisa dinaikkan lewat konfigurasi apa pun).
MAX_UPLOAD_MB=""

# Authentication
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WAJIB diisi untuk production!
AUTH_SECRET="your-random-secret-here"

# Site URL (untuk SEO, email, dan sitemap)
NEXT_PUBLIC_SITE_URL="https://sdn-mongisidi1.sch.id"

# CORS: origin yang diizinkan memanggil /api/* (dipisah koma).
# Kosongkan jika tidak ada frontend/domain terpisah.
# Contoh: ALLOWED_ORIGINS="https://admin.sdn-mongisidi1.sch.id"
ALLOWED_ORIGINS=""

# ============================================
# Email Configuration (opsional)
# ============================================
# Digunakan untuk notifikasi form kontak dan pengaduan
# Untuk Gmail: gunakan App Password, bukan password biasa
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="CMS MONSA <noreply@sdn-mongisidi1.sch.id>"

# Email admin untuk menerima notifikasi
ADMIN_EMAIL="admin@sdn-mongisidi1.sch.id"

# ============================================
# WhatsApp & Telegram Notifications (opsional)
# ============================================
# Notifikasi otomatis saat ada pengaduan/pesan baru via WhatsApp & Telegram.
# Tanpa konfigurasi ini, aplikasi tetap berjalan normal (email saja).

# Fonnte WhatsApp (sudah ada untuk notifikasi orang tua)
# FONNTE_TOKEN="your-fonnte-token"
# FONNTE_DEVICE_ID=""  # opsional, jika akun punya >1 perangkat

# Admin phone untuk WhatsApp notifikasi (format: 628xxx)
ADMIN_PHONE=""

# Telegram Bot (buat bot via @BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""  # ID grup/channel untuk notifikasi

# ============================================
# Sentry Error Tracking (opsional)
# ============================================
# DSN dari Sentry project — kosongkan jika tidak pakai Sentry.
# Client-side (browser): NEXT_PUBLIC_SENTRY_DSN
# Server-side: SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Auth token untuk source map upload (hanya butuh saat build)
SENTRY_AUTH_TOKEN=""

# ============================================
# Vercel Cron — Backup Neon (opsional)
# ============================================
# Dipakai endpoint /api/cron/backup (dipanggil Vercel Cron tiap 02.00 WITA —
# jadwal "0 18 * * *" UTC di vercel.json, karena jadwal Vercel Cron
# menggunakan UTC dan WITA/Makassar = UTC+8).
# Backup = membuat BRANCH Neon (snapshot point-in-time) + pruning otomatis.
#
# CRON_SECRET: token otorisasi. Vercel Cron mengirim header
#   `Authorization: Bearer $CRON_SECRET` otomatis bila variabel ini diset.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# API key dari Neon Console: Settings → Developer settings → API keys
NEON_API_KEY=""
# ID project Neon (ada di URL dashboard, format .../app/projects/<ID>)
NEON_PROJECT_ID=""
# Jumlah backup yang dipertahankan (default 7)
# BACKUP_RETENTION="7"

# ============================================
# Log Aggregation — Loki (opsional)
# ============================================
# URL Loki untuk mengirim logs. Kosongkan untuk stdout only.
# Jalankan stack logging: docker compose -f docker-compose.logging.yml up -d
# Contoh: LOKI_URL="http://localhost:3100/loki/api/v1/push"
LOKI_URL=""

# ============================================
# SSL / Domain Configuration
# ============================================
# Domain untuk SSL certificate (Let's Encrypt)
SITE_DOMAIN="sdn-mongisidi1.sch.id"

# App port (default 3000, change if needed)
APP_PORT="3000"

# ============================================
# Seed Passwords (prisma/seed.ts)
# ============================================
# Password untuk akun seed. ⚠️ PRODUKSI: WAJIB diganti dengan password kuat
# (min. 12 karakter) sebelum menjalankan seed — jangan pakai nilai default
# di bawah (nilai default hanya untuk development). Akun produksi otomatis
# ditandai mustChangePassword=true sehingga password diganti saat login
# pertama, tapi jangan mengandalkan itu.
# Jangan pernah commit nilai asli produksi ke git.
SEED_ADMIN_PASSWORD=""
SEED_OPERATOR_PASSWORD=""
SEED_GURU_PASSWORD=""
SEED_ORTU_PASSWORD=""
SEED_SISWA_PASSWORD=""
