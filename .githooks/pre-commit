#!/usr/bin/env bash
# ============================================================
# Pre-commit hook — delegasi ke gate bersama (.githooks/run-checks.sh).
#
# Gate yang SAMA dijalankan manual tanpa commit lewat:
#   bun run hooks:check
# Jadi tidak ada dua versi validasi yang bisa drift.
#
# Gate berisi (lihat .githooks/run-checks.sh):
#   1. Guard cepat (gagal seketika):
#      - Tolak commit yang meng-stage file .db / .db-journal / .env*
#        (kecuali .env.example) → mencegah pola lama terulang:
#        "fix: .env path" & "re-seed database" (REPO_HEALTH_AUDIT 1.1 & 1.3).
#      - Tolak commit yang menghapus src/app/api/upload/route.ts /
#        src/proxy.ts → mencegah "restore: upload route"
#        (REPO_HEALTH_AUDIT 1.2).
#      - Tolak commit yang meng-stage artefak cookie sesi (cookies.txt
#        dsb., by-name & sniff isi Netscape cookie jar) — isinya
#        monsa_session/monsa_csrf yang masih valid.
#      - Tolak commit yang meng-stage lockfile selain bun.lock
#        (package-lock.json / yarn.lock / pnpm-lock.yaml / bun.lockb /
#        npm-shrinkwrap.json) — lockfile kanonik hanya bun.lock.
#   2. Warm-up rute dev server (non-blocking, --if-up).
#   3. Gate penuh: bun run check (typecheck · lint · markdownlint ·
#      schema-sync · vitest).
#
# Di CI (GITHUB_ACTIONS=true) guard 1/3/4 memindai working tree ter-track
# (git ls-files) alih-alih index — menangkap file terlarang yang lolos
# lewat `git commit --no-verify` lalu di-push (lihat hooks-gate.yml).
#
# Pemasangan (sekali per clone):
#   bun run hooks:install   # atau: git config core.hooksPath .githooks
#
# Lewati sementara (tidak disarankan):
#   git commit --no-verify
# ============================================================
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
exec bash "$ROOT_DIR/.githooks/run-checks.sh"
