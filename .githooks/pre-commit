#!/usr/bin/env bash
# ============================================================
# Pre-commit hook: guard kebersihan repo + typecheck/lint/test.
#
# Guard cepat (dijalankan SEBELUM bun check — gagal seketika):
#   1. Tolak commit yang meng-stage file .db / .db-journal / .env*
#      (kecuali .env.example)
#      → mencegah pola lama terulang: "fix: .env path" &
#        "re-seed database" (REPO_HEALTH_AUDIT 1.1 & 1.3).
#   2. Tolak commit yang menghapus src/app/api/upload/route.ts /
#      src/proxy.ts
#      → mencegah pola lama terulang: "restore: upload route"
#        (REPO_HEALTH_AUDIT 1.2).
#
# Pemasangan (sekali per clone):
#   bun run hooks:install   # atau: git config core.hooksPath .githooks
#
# Lewati sementara (tidak disarankan):
#   git commit --no-verify
# ============================================================
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

BLOCKED=0

# --- Guard 1: file .db / .env ter-stage? --------------------------------
# .env.example adalah satu-satunya file .env* yang sah untuk di-commit.
FORBIDDEN="$(git diff --cached --name-only | awk '
  /\.db(-journal)?$/ { print; next }
  {
    base = $0
    sub(/^.*\//, "", base)
    if (base ~ /^\.env(\.|$)/ && base != ".env.example") print
  }
' || true)"

if [[ -n "$FORBIDDEN" ]]; then
  echo "❌ [pre-commit] Commit DITOLAK — file terlarang ter-stage:"
  echo "$FORBIDDEN" | sed 's/^/   - /'
  echo "   File .db / .env tidak boleh di-commit (kecuali .env.example)."
  echo "   Hapus dari index:  git reset HEAD <file>"
  BLOCKED=1
fi

# --- Guard 2: upload route / CORS proxy dihapus? ------------------------
for f in src/app/api/upload/route.ts src/proxy.ts; do
  in_head=0
  in_index=0
  git cat-file -e "HEAD:$f" 2>/dev/null && in_head=1
  git ls-files --cached --error-unmatch -- "$f" >/dev/null 2>&1 && in_index=1

  if (( in_head && ! in_index )); then
    echo "❌ [pre-commit] Commit DITOLAK — file kritikal dihapus: $f"
    echo "   Upload route & CORS proxy WAJIB ada (REPO_HEALTH_AUDIT C.9)."
    echo "   Jika penghapusan disengaja:  git commit --no-verify"
    BLOCKED=1
  fi
done

if [[ "$BLOCKED" -eq 1 ]]; then
  echo
  echo "⛔ [pre-commit] Guard repository memblokir commit."
  exit 1
fi

echo "🔍 [pre-commit] Guard repo bersih — menjalankan typecheck + lint + test..."
bun run check

echo "✅ [pre-commit] Semua validasi lulus — commit diizinkan."
