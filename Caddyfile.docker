# ============================================
# CMS MONSA - Caddyfile for Docker
# ============================================
# This Caddyfile is designed for use with Docker.
# It automatically handles SSL/TLS certificates via Let's Encrypt.
#
# Environment variables:
#   SITE_DOMAIN - Your domain (e.g., sdn-mongisidi1.sch.id)
#   ADMIN_EMAIL - Email for Let's Encrypt notifications
#

# Global options
{
    # Email for Let's Encrypt certificate notifications
    email {$ADMIN_EMAIL:admin@sdn-mongisidi1.sch.id}
    
    # Use Let's Encrypt production (remove for testing)
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
    
    # Enable HTTP/3 (QUIC)
    experimental_http3
    
    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}

# ============================================
# Main site with automatic HTTPS
# ============================================
{$SITE_DOMAIN:sdn-mongisidi1.sch.id} {
    # Security headers
    header {
        # HSTS (2 years, include subdomains, preload)
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        
        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"
        
        # Prevent clickjacking
        X-Frame-Options "DENY"
        
        # XSS protection
        X-XSS-Protection "1; mode=block"
        
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Permissions policy
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        
        # Remove server header
        -Server
    }
    
    # Reverse proxy to Next.js app
    handle {
        reverse_proxy app:3000 {
            # Pass real client info
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            
            # Health check
            health_uri /api/health
            health_interval 30s
            health_timeout 10s
        }
    }
    
    # Logging
    log {
        output stdout
        format json
    }
}

# ============================================
# HTTP to HTTPS redirect (for bare domain)
# ============================================
http://{$SITE_DOMAIN:sdn-mongisidi1.sch.id} {
    redir https://{host}{uri} permanent
}

# ============================================
# WWW subdomain redirect
# ============================================
www.{$SITE_DOMAIN:sdn-mongisidi1.sch.id} {
    redir https://{$SITE_DOMAIN:sdn-mongisidi1.sch.id}{uri} permanent
}

# ============================================
# Catch-all for undefined domains
# ============================================
:80 {
    respond "Not Found" 404
}
