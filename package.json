{
  "name": "sdn-mongisidi1-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && eslint . && markdownlint-cli2 && node scripts/check-schema-sync.mjs && vitest run",
    "check:schema": "node scripts/check-schema-sync.mjs",
    "check:public-scope": "vitest run src/lib/__tests__/public-scope.test.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:check": "bash .githooks/run-checks.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:warmup": "bunx tsx e2e/warmup-cli.ts",
    "test:e2e": "bunx tsx scripts/run-e2e.ts",
    "test:e2e:local": "bunx tsx scripts/run-e2e-local.ts",
    "check:warmup-declarations": "bunx tsx scripts/check-warmup-declarations.ts",
    "check:non2xx": "bunx tsx scripts/check-non2xx.ts",
    "check:server-log": "bunx tsx scripts/check-server-log.ts",
    "check:data-leak": "bunx tsx scripts/check-test-data-leak.ts",
    "triage:e2e": "bunx tsx scripts/triage-e2e.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:seed": "bunx tsx prisma/seed.ts",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "clean:orphans": "bunx tsx scripts/cleanup-orphan-files.ts",
    "backup:db": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "health:check": "bunx tsx scripts/health-check.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "bunx tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/nextjs": "^10.70.0",
    "@vercel/analytics": "^2.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "ioredis": "^6.0.0",
    "isomorphic-dompurify": "^3.21.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "otpauth": "^9.5.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.11.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true,
    "@parcel/watcher": true,
    "@prisma/client": true,
    "@prisma/engines": true
  }
}
