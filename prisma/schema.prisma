// Prisma schema for UPT SPF SD Negeri Unggulan Mongisidi 1 — School CMS
// learn more: https://pris.ly/d/prisma-schema
//
// Untuk PostgreSQL: ubah provider menjadi "postgresql" di bawah ini
// Untuk SQLite (development): gunakan "sqlite" seperti saat ini

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- RBAC ----------
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("OPERATOR") // SUPER_ADMIN | OPERATOR | GURU | ORANG_TUA | SISWA
  guardianClassId String? // Wali kelas untuk role GURU (hanya boleh absen di kelas ini)
  guardianStudentId String? // Untuk role ORANG_TUA: siswa yang dipantau (portal orang tua)
  teacherId String?  @unique // Tautan ke master guru (profil di website)
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  studentId String?  @unique // Untuk role SISWA: akun portal siswa
  student   Student? @relation("StudentAccount", fields: [studentId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardianClass     Class?            @relation(fields: [guardianClassId], references: [id])
  guardianStudent   Student?          @relation("GuardianStudent", fields: [guardianStudentId], references: [id])
  news              News[]
  activityLogs      ActivityLog[]
  contactMessages   ContactMessage[]
  complaints        Complaint[]
  uploadedDocuments Document[]
  reviewedEnrollments Enrollment[]
  attendanceRecords Attendance[]
  bosExpenditures   BosExpenditure[]
  bosDocuments      BosDocument[]
}

// ---------- CONTENT ----------
model News {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  excerpt      String
  content      String
  coverImage   String?
  category     String    @default("Kegiatan") // Akademik | Kegiatan | Prestasi
  status       String    @default("DRAFT") // DRAFT | PUBLISHED
  authorId     String
  author       User      @relation(fields: [authorId], references: [id])
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  isPinned    Boolean   @default(false)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Agenda {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  time        String?
  location    String?
  category    String   @default("Umum") // Akademik | Kegiatan | Libur | Umum
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Teacher {
  id          String   @id @default(cuid())
  name        String
  position    String
  subject     String?
  education   String?
  photo       String?
  nuptk       String?  // NUPTK dari Dapodik (identifier sync)
  nip         String?  // NIP dari Dapodik
  // ---- Identitas (diisi otomatis dari sync Dapodik) ----
  nik               String?
  gender            String?  // LAKI_LAKI | PEREMPUAN
  tempatLahir       String?
  tanggalLahir      DateTime?
  agama             String?
  statusKepegawaian String?  // PNS | GTK/PTK | PTT ...
  jenisPtk          String?  // Guru Kelas | Guru Mapel | Tendik | ...
  pangkatGolongan   String?
  bidangStudi       String?  // bidang studi terakhir dari Dapodik
  // ---- Kontak & personal (dikelola manual via form) ----
  phone     String?  // HP — manual, tidak ditimpa sync
  email     String?  // manual, tidak ditimpa sync
  motto     String?  // kutipan singkat, tampil di profil
  riwayat   String?  // riwayat / bio singkat
  sertifikasi String? // sertifikasi / diklat (teks bebas)
  prestasi  String?  // prestasi / penghargaan (teks bebas)
  badges    String?  // badge terpisah koma: "Sertifikasi,MRI,Inklusi"
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  archivedAt  DateTime? // null = aktif, DateTime = diarsipkan oleh sync Dapodik
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeroomClasses Class[]
  account        User?

  @@index([nuptk])
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("PHOTO") // PHOTO | VIDEO
  url         String
  thumbnail   String?
  category    String   @default("Kegiatan") // Kegiatan | Prestasi | Fasilitas | Upacara
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String?
  studentName String?
  studentId   String?  // tautan ke master siswa (opsional; prestasi tim boleh tanpa siswa)
  student     Student? @relation(fields: [studentId], references: [id])
  level       String   @default("Kabupaten") // Sekolah | Kecamatan | Kabupaten | Provinsi | Nasional | Internasional
  category    String   @default("Akademik") // Akademik | Non-Akademik
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
}

// ---------- STUDENT & CLASS MANAGEMENT ----------
model Class {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Kelas 1A", "Kelas 2B"
  grade       String   // 1, 2, 3, 4, 5, 6 (Kelas 1–6)
  stream      String?  // opsional: label rombel (misal: A, B) — SD tanpa jurusan
  academicYear String  // e.g., "2025/2026"
  dapodikId   String?  // ID rombel dari Dapodik (stabil untuk matching sync)
  homeroomTeacherId String?
  homeroomTeacher Teacher? @relation(fields: [homeroomTeacherId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    Student[]
  attendances Attendance[]
  guardianUsers User[] // akun User (role GURU) yang menjadi wali kelas ini

  @@index([grade, academicYear])
  @@index([dapodikId])
}

model Student {
  id          String   @id @default(cuid())
  nis         String   @unique // Nomor Induk Siswa
  nisn        String?  // Nomor Induk Siswa Nasional
  dapodikId   String?  @unique // peserta_didik_id dari Dapodik (identitas stabil)
  name        String
  dateOfBirth DateTime?
  gender      String?  // LAKI_LAKI | PEREMPUAN
  address     String?
  phone       String?
  email       String?
  parentName  String?
  parentPhone String?
  photoUrl    String?  // foto siswa (tampil di galeri siswa website)
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  isActive    Boolean  @default(true)
  archivedAt  DateTime? // null = aktif, DateTime = diarsipkan oleh sync Dapodik
  enrollmentDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendances Attendance[]
  guardianUsers User[] @relation("GuardianStudent") // akun User (role ORANG_TUA) yang memantau siswa ini
  account      User?   @relation("StudentAccount")   // akun portal siswa (role SISWA)
  achievements Achievement[]

  @@index([classId])
  @@index([nis])
  @@index([nisn])
}

// ---------- KEHADIRAN (ABSENSI) ----------
model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  date      DateTime
  status    String   @default("HADIR") // HADIR | SAKIT | IZIN | ALFA
  note      String?
  createdById String?
  createdBy User?    @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([classId, date])
}

// ---------- DOCUMENT MANAGEMENT ----------
model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int      // in bytes
  mimeType    String
  category    String   @default("Umum") // Akademik | Administrasi | Kurikulum | Lainnya
  uploadedById String
  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
  isPublic    Boolean  @default(false)
  downloadCount Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

// ---------- SPMB/PPDB ----------
model Enrollment {
  id              String   @id @default(cuid())
  // Data Siswa
  nisn            String
  fullName        String
  gender          String   // LAKI_LAKI | PEREMPUAN
  dateOfBirth     DateTime
  placeOfBirth    String
  address         String
  phone           String?
  email           String?
  // Data Orang Tua/Wali
  parentName      String
  parentPhone     String
  parentEmail     String?
  parentOccupation String?
  // Asal Sekolah
  previousSchool  String
  previousSchoolAddress String?
  // Pilihan (Jalur SPMB SD)
  programChoice   String   // Zonasi | Afirmasi | Prestasi | Perpindahan Tugas
  // Dokumen
  birthCertUrl    String?
  diplomaUrl      String?
  photoUrl        String?
  // Status
  status          String   @default("PENDING") // PENDING | REVIEWING | ACCEPTED | REJECTED
  notes           String?
  reviewedById    String?
  reviewedBy      User?    @relation(fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------- SITE ----------
model SiteSetting {
  id                String   @id @default("singleton")
  schoolName        String   @default("UPT SPF SD Negeri Unggulan Mongisidi 1")
  npsn              String   @default("40313912")
  logo              String?
  address           String   @default("Jln. Wr. Monginsidi No.13, Maricaya Baru, Makassar, Sulawesi Selatan")
  phone             String   @default("04118918116")
  email             String   @default("sdn.unggulanmonginsidi@yahoo.co.id")
  mapEmbed          String?
  vision            String
  mission           String
  history           String
  principalName     String   @default("Nawawi Hamzah, S.Pd., M.Pd.")
  principalPhoto    String?
  principalWelcome  String
  facebook          String?
  instagram         String?
  youtube           String?
  tiktok            String?
  // quick stats
  studentCount      Int      @default(402)
  teacherCount      Int      @default(28)
  facilityCount     Int      @default(18)
  achievementCount  Int      @default(45)
  spmbInfo          String
  spmbLink          String?
  updatedAt         DateTime @updatedAt
}

// ---------- DAPODIK SYNC ----------
model DapodikConfig {
  id          String   @id @default("singleton")
  npsn        String
  token       String   // simpan token (tidak di-expose utuh ke client)
  host        String   @default("localhost")
  port        Int      @default(5774)
  protocol    String   @default("http") // http | https
  allowInsecureInProduction Boolean @default(false) // izinkan HTTP di production (jaringan lokal/VPN aman)
  // Auto-sync berkala (scheduler di src/instrumentation.ts)
  autoSyncEnabled        Boolean   @default(false)
  autoSyncIntervalHours  Int      @default(24) // 1-24 jam (lihat scheduler)
  autoSyncLastRunAt      DateTime?
  autoSyncLastStatus     String?   // OK | ERROR
  autoSyncLastError      String?
  lastSyncAt  DateTime?
  lastSyncBy  String?  // userId
  // Bila true (default), siswa/guru yang tidak ada lagi di Dapodik ikut
  // dinonaktifkan (isActive=false). Bila false, mereka dibiarkan aktif.
  archiveUnlisted Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userName   String
  action     String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT
  entity     String   // News | Announcement | Agenda | Teacher | Gallery | User | SiteSetting | Achievement
  entityId   String?
  detail     String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  handledBy String?
  User      User?    @relation(fields: [handledBy], references: [id])
  createdAt DateTime @default(now())
}

// ---------- PENGADUAN ----------
model Complaint {
  id           String   @id @default(cuid())
  // Identitas pelapor
  name         String
  email        String
  phone        String
  role         String   @default("Orang Tua") // Orang Tua | Siswa | Masyarakat | Alumni
  // Detail pengaduan
  category     String   @default("Akademik") // Akademik | Fasilitas | Tata Tertib | Tenaga Pendidik | Lainnya
  subject      String
  message      String
  isAnonymous  Boolean  @default(false)
  // Status & response
  status       String   @default("BARU") // BARU | DIPROSES | SELESAI | DITOLAK
  priority     String   @default("NORMAL") // RENDAH | NORMAL | TINGGI
  response     String?
  responseBy   String?
  User         User?    @relation(fields: [responseBy], references: [id])
  respondedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------- ORGANISASI ----------
model OrgStructure {
  id        String   @id @default(cuid())
  name      String
  position  String   // jabatan dalam struktur organisasi
  photo     String?
  nuptk     String?  // NUPTK dari Dapodik (identifier sync)
  nip       String?  // NIP dari Dapodik
  nik       String?  // NIK dari Dapodik
  bio       String?  // profil singkat — tampil di modal detail publik
  contact   String?  // kontak (HP/email) — tampil di modal detail publik
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// ---------- TRANSPARANSI ANGGARAN (ARKAS / DANA BOS) ----------
model BosExpenditure {
  id           String   @id @default(cuid())
  year         Int      // tahun anggaran, mis. 2026
  source       String   // sumber dana: BOS Reguler | BOS Kinerja | DAK | Lainnya
  category     String   // kategori belanja ARKAS, mis. Honorarium, Pembelajaran
  item         String   // uraian kegiatan/belanja
  amount       Int      // nominal dalam Rupiah
  quarter      Int?     // triwulan 1-4 (opsional)
  note         String?
  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([year])
  @@index([source])
}

// Dokumen pendukung transparansi — output ARKAS / bukti belanja BOS dalam PDF
model BosDocument {
  id           String   @id @default(cuid())
  year         Int      // tahun anggaran, mis. 2026
  title        String   // judul dokumen, mis. "Output ARKAS 2026"
  description  String?
  fileUrl      String   // path relatif /uploads/... (file PDF di public/uploads)
  fileName     String   // nama file asli (untuk tampilan)
  fileSize     Int      // ukuran file dalam byte
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([year])
}
