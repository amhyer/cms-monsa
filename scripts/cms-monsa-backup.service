[Unit]
Description=CMS MONSA Database Backup
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/cms-monsa
ExecStart=/srv/cms-monsa/scripts/backup-db.sh
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/cms-monsa/backups
ReadWritePaths=/var/log
